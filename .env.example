# Public client configuration (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only secrets. Add these to Vercel Environment Variables as well.
# Never prefix private keys with VITE_.
GROQ_API_KEY_1=your-groq-api-key
# GROQ_API_KEY_2=your-backup-groq-api-key
# GROQ_API_KEY_3=your-backup-groq-api-key
